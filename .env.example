# Copy this file to .env and fill in real values. Never commit .env.

# Source: cloud MySQL ERP database
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Target warehouse
WAREHOUSE_HOST=
WAREHOUSE_PORT=
WAREHOUSE_USER=
WAREHOUSE_PASSWORD=
WAREHOUSE_DATABASE=
WAREHOUSE_SCHEMA=

# dbt
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev

# Local discovery database (Docker, see sql/setup/README.md)
MARIADB_ROOT_PASSWORD=
MARIADB_PORT=3307
