# Copy this file to .env and fill in real values. Never commit .env.

# Source: cloud MySQL ERP database
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Target warehouse
# Target warehouse (local Postgres in Docker, see ADR 0002)
WAREHOUSE_HOST=127.0.0.1
WAREHOUSE_PORT=5433
WAREHOUSE_USER=fortix
WAREHOUSE_PASSWORD=
WAREHOUSE_DATABASE=fortix_warehouse
WAREHOUSE_SCHEMA=raw

# dbt
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev

# Local discovery database (Docker, see sql/setup/README.md)
MARIADB_ROOT_PASSWORD=
MARIADB_PORT=3307
