{
  "name": "Fortix ERP Analytics",
  "dataColors": ["#2A6FDB", "#F28E2B", "#2CA58D", "#8E6BBF", "#E15759", "#59A1D8", "#B07AA1", "#9C755F"],
  "background": "#FFFFFF",
  "foreground": "#1F2937",
  "tableAccent": "#2A6FDB",
  "good": "#2CA58D",
  "neutral": "#F2B134",
  "bad": "#E15759",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2937" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4B5563" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1F2937" }
  },
  "visualStyles": {
    "*": { "*": {
      "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
      "border": [{ "show": true, "color": { "solid": { "color": "#E5E7EB" } }, "radius": 8 }]
    } },
    "page": { "*": { "background": [{ "color": { "solid": { "color": "#F5F7FA" } }, "transparency": 0 }] } }
  }
}
